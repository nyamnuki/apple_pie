[
 {
  "no": 1,
  "file": "001.mp3",
  "text": "10 만들기"
 },
 {
  "no": 2,
  "file": "002.mp3",
  "text": "10, 20, 그리고 21, 22, 23! 10묶음 2개와 낱개 3개는 모두 23개예요."
 },
 {
  "no": 3,
  "file": "003.mp3",
  "text": "100"
 },
 {
  "no": 4,
  "file": "004.mp3",
  "text": "10개짜리 상자는 몇 개인가요? 낱개는 몇 개인가요?"
 },
 {
  "no": 5,
  "file": "005.mp3",
  "text": "10개짜리 상자와 낱개가 있어요. 모두 얼마나 될까요?"
 },
 {
  "no": 6,
  "file": "006.mp3",
  "text": "10묶음을 먼저 세고, 그다음 낱개를 세요. 10묶음 3개와 낱개 5개는 35예요. 수를 쓸 때도 10묶음의 수를 앞에 써요!"
 },
 {
  "no": 7,
  "file": "007.mp3",
  "text": "10씩 묶어 세기"
 },
 {
  "no": 8,
  "file": "008.mp3",
  "text": "10을 만들려면 상자의 빈칸을 세어 봐요. 빈칸 수만큼 더 있으면 10이 돼요."
 },
 {
  "no": 9,
  "file": "009.mp3",
  "text": "2, 4, 6, 8, 10, 12! 2씩 세면 하나씩 세는 것보다 빨라요."
 },
 {
  "no": 10,
  "file": "010.mp3",
  "text": "2씩 뛰어 세기"
 },
 {
  "no": 11,
  "file": "011.mp3",
  "text": "2씩 세어 볼게요… 2, 4, 6…"
 },
 {
  "no": 12,
  "file": "012.mp3",
  "text": "30분"
 },
 {
  "no": 13,
  "file": "013.mp3",
  "text": "4쌍이 되고 남은 것은 0마리예요! 남는 것이 없으면 짝수예요."
 },
 {
  "no": 14,
  "file": "014.mp3",
  "text": "5, 10, 15, 20! 5씩 세면 정말 빨라요."
 },
 {
  "no": 15,
  "file": "015.mp3",
  "text": "5개를 덜어 냈어요. 이제 블루베리가 7개 남았어요!"
 },
 {
  "no": 16,
  "file": "016.mp3",
  "text": "5씩 뛰어 세기"
 },
 {
  "no": 17,
  "file": "017.mp3",
  "text": "5씩 세어 볼게요… 5, 10, 15…"
 },
 {
  "no": 18,
  "file": "018.mp3",
  "text": "7마리와 3마리, 모두 10마리예요! 상자가 꽉 찼어요."
 },
 {
  "no": 19,
  "file": "019.mp3",
  "text": "7에서 5번 뛰었더니… 12에 닿았어요! 7 + 5 = 12"
 },
 {
  "no": 20,
  "file": "020.mp3",
  "text": "가방에 있는 것을 방에 놓아 볼까요?"
 },
 {
  "no": 21,
  "file": "021.mp3",
  "text": "같이 규칙을 말해 볼게요."
 },
 {
  "no": 22,
  "file": "022.mp3",
  "text": "같이 나눠 볼게요."
 },
 {
  "no": 23,
  "file": "023.mp3",
  "text": "같이 네모를 찾아볼게요."
 },
 {
  "no": 24,
  "file": "024.mp3",
  "text": "같이 덜어 내고 남은 것을 세어 볼게요."
 },
 {
  "no": 25,
  "file": "025.mp3",
  "text": "같이 뛰어 볼게요."
 },
 {
  "no": 26,
  "file": "026.mp3",
  "text": "같이 물에 비춰 볼게요."
 },
 {
  "no": 27,
  "file": "027.mp3",
  "text": "같이 세모를 찾아볼게요."
 },
 {
  "no": 28,
  "file": "028.mp3",
  "text": "같이 세어 볼게요. 10, 20, 30…"
 },
 {
  "no": 29,
  "file": "029.mp3",
  "text": "같이 세어 볼게요. 2, 4, 6…"
 },
 {
  "no": 30,
  "file": "030.mp3",
  "text": "같이 세어 볼게요. 5, 10, 15…"
 },
 {
  "no": 31,
  "file": "031.mp3",
  "text": "같이 세어 볼까요?"
 },
 {
  "no": 32,
  "file": "032.mp3",
  "text": "같이 시계를 읽어 볼게요."
 },
 {
  "no": 33,
  "file": "033.mp3",
  "text": "같이 앞에서부터 세어 볼게요."
 },
 {
  "no": 34,
  "file": "034.mp3",
  "text": "같이 재 볼게요."
 },
 {
  "no": 35,
  "file": "035.mp3",
  "text": "같이 줄을 세워 볼게요."
 },
 {
  "no": 36,
  "file": "036.mp3",
  "text": "같이 짝을 지어 볼게요."
 },
 {
  "no": 37,
  "file": "037.mp3",
  "text": "같이 채워 볼게요."
 },
 {
  "no": 38,
  "file": "038.mp3",
  "text": "같이 하나씩 더해 볼게요."
 },
 {
  "no": 39,
  "file": "039.mp3",
  "text": "같이 하나씩 세어 볼게요."
 },
 {
  "no": 40,
  "file": "040.mp3",
  "text": "같이 확인해 볼까요…"
 },
 {
  "no": 41,
  "file": "041.mp3",
  "text": "개구리"
 },
 {
  "no": 42,
  "file": "042.mp3",
  "text": "구름"
 },
 {
  "no": 43,
  "file": "043.mp3",
  "text": "구름 빈백"
 },
 {
  "no": 44,
  "file": "044.mp3",
  "text": "구름 솜"
 },
 {
  "no": 45,
  "file": "045.mp3",
  "text": "규칙은 같은 부분이 계속 되풀이되는 거예요. 되풀이되는 부분을 찾으면 다음에 올 것을 알 수 있어요."
 },
 {
  "no": 46,
  "file": "046.mp3",
  "text": "기다리는 꽃을 하나씩 눌러 화분에 더해 봐요. 이어서 세어요!"
 },
 {
  "no": 47,
  "file": "047.mp3",
  "text": "긴바늘은 6에 있어요. 짧은바늘이 막 지난 숫자는 무엇인가요?"
 },
 {
  "no": 48,
  "file": "048.mp3",
  "text": "긴바늘은 6에, 짧은바늘은 10에서 조금 지난 곳에 있어요. 열 시 삼십 분이에요!"
 },
 {
  "no": 49,
  "file": "049.mp3",
  "text": "긴바늘은 6에, 짧은바늘은 11에서 조금 지난 곳에 있어요. 열한 시 삼십 분이에요!"
 },
 {
  "no": 50,
  "file": "050.mp3",
  "text": "긴바늘은 6에, 짧은바늘은 12에서 조금 지난 곳에 있어요. 열두 시 삼십 분이에요!"
 },
 {
  "no": 51,
  "file": "051.mp3",
  "text": "긴바늘은 6에, 짧은바늘은 1에서 조금 지난 곳에 있어요. 한 시 삼십 분이에요!"
 },
 {
  "no": 52,
  "file": "052.mp3",
  "text": "긴바늘은 6에, 짧은바늘은 2에서 조금 지난 곳에 있어요. 두 시 삼십 분이에요!"
 },
 {
  "no": 53,
  "file": "053.mp3",
  "text": "긴바늘은 6에, 짧은바늘은 3에서 조금 지난 곳에 있어요. 세 시 삼십 분이에요!"
 },
 {
  "no": 54,
  "file": "054.mp3",
  "text": "긴바늘은 6에, 짧은바늘은 4에서 조금 지난 곳에 있어요. 네 시 삼십 분이에요!"
 },
 {
  "no": 55,
  "file": "055.mp3",
  "text": "긴바늘은 6에, 짧은바늘은 5에서 조금 지난 곳에 있어요. 다섯 시 삼십 분이에요!"
 },
 {
  "no": 56,
  "file": "056.mp3",
  "text": "긴바늘은 6에, 짧은바늘은 6에서 조금 지난 곳에 있어요. 여섯 시 삼십 분이에요!"
 },
 {
  "no": 57,
  "file": "057.mp3",
  "text": "긴바늘은 6에, 짧은바늘은 7에서 조금 지난 곳에 있어요. 일곱 시 삼십 분이에요!"
 },
 {
  "no": 58,
  "file": "058.mp3",
  "text": "긴바늘은 6에, 짧은바늘은 8에서 조금 지난 곳에 있어요. 여덟 시 삼십 분이에요!"
 },
 {
  "no": 59,
  "file": "059.mp3",
  "text": "긴바늘은 6에, 짧은바늘은 9에서 조금 지난 곳에 있어요. 아홉 시 삼십 분이에요!"
 },
 {
  "no": 60,
  "file": "060.mp3",
  "text": "긴바늘이 12를 가리키면 정각이에요. 짧은바늘이 몇 시인지 알려 줘요."
 },
 {
  "no": 61,
  "file": "061.mp3",
  "text": "긴바늘이 12에, 짧은바늘이 10에 있어요. 열 시예요!"
 },
 {
  "no": 62,
  "file": "062.mp3",
  "text": "긴바늘이 12에, 짧은바늘이 11에 있어요. 열한 시예요!"
 },
 {
  "no": 63,
  "file": "063.mp3",
  "text": "긴바늘이 12에, 짧은바늘이 12에 있어요. 열두 시예요!"
 },
 {
  "no": 64,
  "file": "064.mp3",
  "text": "긴바늘이 12에, 짧은바늘이 1에 있어요. 한 시예요!"
 },
 {
  "no": 65,
  "file": "065.mp3",
  "text": "긴바늘이 12에, 짧은바늘이 2에 있어요. 두 시예요!"
 },
 {
  "no": 66,
  "file": "066.mp3",
  "text": "긴바늘이 12에, 짧은바늘이 3에 있어요. 세 시예요!"
 },
 {
  "no": 67,
  "file": "067.mp3",
  "text": "긴바늘이 12에, 짧은바늘이 4에 있어요. 네 시예요!"
 },
 {
  "no": 68,
  "file": "068.mp3",
  "text": "긴바늘이 12에, 짧은바늘이 5에 있어요. 다섯 시예요!"
 },
 {
  "no": 69,
  "file": "069.mp3",
  "text": "긴바늘이 12에, 짧은바늘이 6에 있어요. 여섯 시예요!"
 },
 {
  "no": 70,
  "file": "070.mp3",
  "text": "긴바늘이 12에, 짧은바늘이 7에 있어요. 일곱 시예요!"
 },
 {
  "no": 71,
  "file": "071.mp3",
  "text": "긴바늘이 12에, 짧은바늘이 8에 있어요. 여덟 시예요!"
 },
 {
  "no": 72,
  "file": "072.mp3",
  "text": "긴바늘이 12에, 짧은바늘이 9에 있어요. 아홉 시예요!"
 },
 {
  "no": 73,
  "file": "073.mp3",
  "text": "긴바늘이 6을 가리키면 30분이에요. 짧은바늘이 막 지난 숫자가 몇 시예요."
 },
 {
  "no": 74,
  "file": "074.mp3",
  "text": "긴바늘이 반 바퀴 돌아 6에 왔어요. 4시 30분이에요!"
 },
 {
  "no": 75,
  "file": "075.mp3",
  "text": "길이를 잴 때는 한쪽 끝부터 다른 쪽 끝까지 블록을 빈틈없이, 겹치지 않게 놓고 세어요."
 },
 {
  "no": 76,
  "file": "076.mp3",
  "text": "깃털"
 },
 {
  "no": 77,
  "file": "077.mp3",
  "text": "꽃"
 },
 {
  "no": 78,
  "file": "078.mp3",
  "text": "꽃 8송이에 5송이를 더하면 13송이예요!"
 },
 {
  "no": 79,
  "file": "079.mp3",
  "text": "꽃 화분"
 },
 {
  "no": 80,
  "file": "080.mp3",
  "text": "꽃잎 러그"
 },
 {
  "no": 81,
  "file": "081.mp3",
  "text": "꿀"
 },
 {
  "no": 82,
  "file": "082.mp3",
  "text": "꿀 등불"
 },
 {
  "no": 83,
  "file": "083.mp3",
  "text": "나무 책상"
 },
 {
  "no": 84,
  "file": "084.mp3",
  "text": "나뭇가지가 어디서 시작해서 어디서 끝나는지 봐요. 아래에 블록을 놓는다고 생각해 봐요."
 },
 {
  "no": 85,
  "file": "085.mp3",
  "text": "나뭇가지는 블록 5개만큼 길어요! 블록을 빈틈없이 이어 놓았어요."
 },
 {
  "no": 86,
  "file": "086.mp3",
  "text": "나뭇가지는 블록 몇 개만큼 길까요?"
 },
 {
  "no": 87,
  "file": "087.mp3",
  "text": "나뭇가지를 봐요. 블록 몇 개만큼 길까요?"
 },
 {
  "no": 88,
  "file": "088.mp3",
  "text": "나뭇잎"
 },
 {
  "no": 89,
  "file": "089.mp3",
  "text": "나뭇잎 액자"
 },
 {
  "no": 90,
  "file": "090.mp3",
  "text": "나뭇잎 침대"
 },
 {
  "no": 91,
  "file": "091.mp3",
  "text": "나뭇잎은 짝이 없는 것이 남았어요. 그러니까 나뭇잎이 더 많아요!"
 },
 {
  "no": 92,
  "file": "092.mp3",
  "text": "나비"
 },
 {
  "no": 93,
  "file": "093.mp3",
  "text": "날아가고 나면 얼마나 남을까요?"
 },
 {
  "no": 94,
  "file": "094.mp3",
  "text": "날아왔어요! 처음 수에서부터 이어서 세어 봐요."
 },
 {
  "no": 95,
  "file": "095.mp3",
  "text": "네모는 몇 개 찾을 수 있나요?"
 },
 {
  "no": 96,
  "file": "096.mp3",
  "text": "네모를 세어 볼게요… 돌아가 있는 것도 네모예요!"
 },
 {
  "no": 97,
  "file": "097.mp3",
  "text": "넷"
 },
 {
  "no": 98,
  "file": "098.mp3",
  "text": "놀이를 끝낼 때마다 새 스티커를 받아요!"
 },
 {
  "no": 99,
  "file": "099.mp3",
  "text": "눌러서 짝을 지어 보고, 어느 쪽이 남는지 봐요."
 },
 {
  "no": 100,
  "file": "100.mp3",
  "text": "눌러서 짝을 지어 봐요. 도토리 하나에 나뭇잎 하나!"
 },
 {
  "no": 101,
  "file": "101.mp3",
  "text": "다른 방법으로 해 볼까?"
 },
 {
  "no": 102,
  "file": "102.mp3",
  "text": "다섯"
 },
 {
  "no": 103,
  "file": "103.mp3",
  "text": "다섯 개씩 모여 있으면 5, 10, 15, 20, 25, 30… 하고 5씩 셀 수 있어요."
 },
 {
  "no": 104,
  "file": "104.mp3",
  "text": "다섯씩 모여 있고, 몇 개는 따로 있어요. 모두 얼마나 될까요?"
 },
 {
  "no": 105,
  "file": "105.mp3",
  "text": "다섯씩 모여 있어요. 모두 얼마나 될까요?"
 },
 {
  "no": 106,
  "file": "106.mp3",
  "text": "다음에 올 것은?"
 },
 {
  "no": 107,
  "file": "107.mp3",
  "text": "달"
 },
 {
  "no": 108,
  "file": "108.mp3",
  "text": "달, 별, 별 — 달, 별, 별! 같은 부분이 계속 되풀이돼요. 그래서 다음엔 달이 와요."
 },
 {
  "no": 109,
  "file": "109.mp3",
  "text": "달빛 등불"
 },
 {
  "no": 110,
  "file": "110.mp3",
  "text": "달빛 이슬"
 },
 {
  "no": 111,
  "file": "111.mp3",
  "text": "달팽이"
 },
 {
  "no": 112,
  "file": "112.mp3",
  "text": "더 날아오면 모두 얼마나 될까요?"
 },
 {
  "no": 113,
  "file": "113.mp3",
  "text": "더 오면 모두 얼마나 될까요?"
 },
 {
  "no": 114,
  "file": "114.mp3",
  "text": "더하기"
 },
 {
  "no": 115,
  "file": "115.mp3",
  "text": "더하기는 모으는 거예요. 처음 수에서부터 이어서 세면 돼요."
 },
 {
  "no": 116,
  "file": "116.mp3",
  "text": "도장을 받았어요!"
 },
 {
  "no": 117,
  "file": "117.mp3",
  "text": "도토리"
 },
 {
  "no": 118,
  "file": "118.mp3",
  "text": "도토리 가랜드"
 },
 {
  "no": 119,
  "file": "119.mp3",
  "text": "도토리 마을에 온 걸 환영해요! 여기서는 세고, 비교하고, 더하고, 빼요."
 },
 {
  "no": 120,
  "file": "120.mp3",
  "text": "도토리와 나뭇잎이 있어요. 어느 쪽이 더 많을까요?"
 },
 {
  "no": 121,
  "file": "121.mp3",
  "text": "도형 찾기"
 },
 {
  "no": 122,
  "file": "122.mp3",
  "text": "도형은 크기가 달라도, 색이 달라도, 돌아가 있어도 이름이 그대로예요. 꼭짓점과 변을 세어 보면 알 수 있어요!"
 },
 {
  "no": 123,
  "file": "123.mp3",
  "text": "동그라미를 5개 찾았어요! 크기와 색은 달라도 모두 동그래요."
 },
 {
  "no": 124,
  "file": "124.mp3",
  "text": "동그라미를 모두 눌러 봐요. 크든 작든, 무슨 색이든 동그라미는 동그라미예요!"
 },
 {
  "no": 125,
  "file": "125.mp3",
  "text": "동물 친구들이 밤 산책을 하려고 줄을 섰어요. 맨 앞이 1번째예요."
 },
 {
  "no": 126,
  "file": "126.mp3",
  "text": "되풀이되는 규칙을 봐요. 다음엔 무엇이 올까요?"
 },
 {
  "no": 127,
  "file": "127.mp3",
  "text": "되풀이되는 부분을 처음부터 다시 말해 봐요… 다음이 보여요!"
 },
 {
  "no": 128,
  "file": "128.mp3",
  "text": "두 개씩 짝지어 있으면 2, 4, 6, 8, 10… 하고 2씩 셀 수 있어요. 하나씩 세는 것보다 빨라요!"
 },
 {
  "no": 129,
  "file": "129.mp3",
  "text": "두 배는 같은 수를 한 번 더 하는 거예요. 호숫가의 수를 세고, 같은 수를 물속에서 한 번 더 세요."
 },
 {
  "no": 130,
  "file": "130.mp3",
  "text": "두 친구가 똑같이 나누면, 한 친구가 얼마나 가질까요?"
 },
 {
  "no": 131,
  "file": "131.mp3",
  "text": "두 친구에게 하나씩 번갈아 준다고 생각해 봐요."
 },
 {
  "no": 132,
  "file": "132.mp3",
  "text": "둘"
 },
 {
  "no": 133,
  "file": "133.mp3",
  "text": "둘씩 짝을 지어 봐요. 남는 것이 없으면 짝수, 하나가 남으면 홀수예요."
 },
 {
  "no": 134,
  "file": "134.mp3",
  "text": "둘씩 짝지어 본다고 생각해 봐요. 하나가 남나요?"
 },
 {
  "no": 135,
  "file": "135.mp3",
  "text": "둘씩 짝지어 있는데, 하나는 혼자예요. 모두 얼마나 될까요?"
 },
 {
  "no": 136,
  "file": "136.mp3",
  "text": "둘씩 짝지어 있어요. 모두 얼마나 될까요?"
 },
 {
  "no": 137,
  "file": "137.mp3",
  "text": "둘이 똑같이 나누려면 한 친구에게 하나씩 번갈아 줘요. 그러면 둘이 같은 수만큼 가져요."
 },
 {
  "no": 138,
  "file": "138.mp3",
  "text": "똑같이 나누기"
 },
 {
  "no": 139,
  "file": "139.mp3",
  "text": "뛰기 버튼을 눌러요. 한 번 뛸 때마다 1, 2, 3… 세어 봐요."
 },
 {
  "no": 140,
  "file": "140.mp3",
  "text": "루루가 먹고 나면 얼마나 남을까요?"
 },
 {
  "no": 141,
  "file": "141.mp3",
  "text": "루루가 먹을 것을 눌러 보고, 남은 것을 세어 봐요."
 },
 {
  "no": 142,
  "file": "142.mp3",
  "text": "루루와 모모가 조개를 6개 찾았어요. 둘이 똑같이 나눠 가져 봐요!"
 },
 {
  "no": 143,
  "file": "143.mp3",
  "text": "리본은 블록 몇 개만큼 길까요?"
 },
 {
  "no": 144,
  "file": "144.mp3",
  "text": "리본이 어디서 시작해서 어디서 끝나는지 봐요. 아래에 블록을 놓는다고 생각해 봐요."
 },
 {
  "no": 145,
  "file": "145.mp3",
  "text": "마지막에 말한 숫자는 10! 그러니까 사과는 모두 10개예요!"
 },
 {
  "no": 146,
  "file": "146.mp3",
  "text": "마흔"
 },
 {
  "no": 147,
  "file": "147.mp3",
  "text": "마흔넷"
 },
 {
  "no": 148,
